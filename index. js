const express = require('express');
const { default: makeWASocket, useMultiFileAuthState, delay } = require('@whiskeysockets/baileys');
const pino = require('pino');
const fs = require('fs');
const path = require('path');
const app = express();
const config = require('./config');

app.use(express.static('public'));

app.get('/pair', async (req, res) => {
  let num = req.query.number.replace(/[^0-9]/g, '');
  const dir = './tmp/' + num;
  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
  const { state, saveCreds } = await useMultiFileAuthState(dir);
  const sock = makeWASocket({ auth: state, logger: pino({ level: "silent" }), browser: ["SHAZI XMD", "Chrome", "1.0"] });
  sock.ev.on('creds.update', saveCreds);
  await delay(2000);
  let code = await sock.requestPairingCode(num);
  code = code.match(/.{1,4}/g).join("-");
  res.json({ code: code, bot: config.botName, owner: config.ownerNumber });
});

app.listen(3000, () => console.log('SHAZI XMD Server Started | Owner 923205610677'));
